extends layout

block content
  .container-fluid.py-4
    .d-flex.justify-content-between.align-items-center.mb-4
      h2.text- User Management Directory
      a.btn-cyan.btn-info.btn-sm(href="/auth/register") + Register New Staff

    .glass-card.p-0.overflow-hidden
      table.table.table-white.table-hover.align-middle.mb-0
        thead.bg-dark
          tr
            th.ps-4 NAME
            th EMAIL 
            th NIN
            th CONTACT
            th ROLE
            th.text-end.pe-4 ACTIONS
        tbody
          if users && users.length > 0
            each u in users
              tr
                td.ps-4
                  .fw-bold #{u.fullname || 'Unknown'}
                  .small.text- Joined: #{u.createdAt ? new Date(u.createdAt).toLocaleDateString() : 'N/A'}
                
                td 
                  span #{u.email || 'No Email'}
                td
                  span.badge.bg-secondary.extra-small NIN: #{u.nin || 'N/A'}
                td 
                  span #{u.phone || 'No Phone'}
                
                td
                  span(class=`badge ${u.role === 'admin' ? 'bg-danger' : 'bg-info text-dark'}`) #{(u.role || 'staff').toUpperCase()}
                td.text-end.pe-4
                    
                    if user && u._id.toString() !== user._id.toString()
                      form.d-inline(action=`/user/delete/${u._id}` method="POST" onsubmit="return confirm('Delete this user permanently?')")
                        button.btn.btn-sm.btn-danger(type="submit")
                          | Delete
          else
            tr
              td.text-center.py-4(colspan="6") No users found in the system.