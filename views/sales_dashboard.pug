extends layout

block content
  .container-fluid.py-4
    .row.mb-4
      .col-md-8
        h2.text-cyan Hello, #{user.fullname}
        p.text-muted Branch: #{user.branch} | Desk: Sales Point A
      .col-md-4.text-end
        a.btn-cyan.btn-.btn-lg.shadow(href="/sales")  Record New Sale

    //- Quick Stats Row
    .row.mb-4
      .col-md-4
        .glass-card.text-center.p-4.border-primary
          h6.text-muted TODAY'S SALES
          h2.text- UGX #{totalCash.toLocaleString()}
          small.text-success #{todaySales.length} Transactions Completed
      
      .col-md-4
        .glass-card.text-center.p-4.border-warning
          h6.text-muted STOCK ALERTS
          h2.text-warning #{lowStockItems.length}
          small.text- Items need restocking

      .col-md-4
        .glass-card.p-4.text-center.border-danger
          h6.text-muted OUT OF STOCK
          h2.text-danger #{outOfStock}
          small.text- Immediate action required

    .row
      //- Left Column: Personal Sales Log
      .col-md-8
        .glass-card
          .d-flex.justify-content-between.align-items-center.mb-3
            h5.text- My Recent Sales (Today)
            a.small(href="/sales/log") View All
          
          .table-responsive
            table.table.table-hover
              thead
                tr
                  th Customer
                  th Item
                  th Total
                  th Action
              tbody
                each sale in todaySales
                  tr
                    td #{sale.customerName}
                    td #{sale.itemName}
                    td.fw-bold #{sale.totalAmount.toLocaleString()}
                    td
                      a.btn.btn-sm.btn-outline-info(href=`/sales/receipt/${sale._id}`)  Receipt
                else
                  tr
                    td(colspan="4").text-center.py-4 No sales recorded yet today.

      //- Right Column: Alerts & Info
      .col-md-4
        //- Low Stock Warning
        .glass-card.mb-4(style="border-left: 5px solid #ff4444;")
          h6.text-danger.mb-3  Low Stock Warning
          ul.list-group.list-group-flush.bg-transparent
            each item in lowStockItems
              li.list-group-item.bg-transparent.text-white.d-flex.justify-content-between
                span #{item.itemName}
                span.badge.bg-danger #{item.quantity} left
            else
              li.list-group-item.bg-transparent.text-success All stock levels healthy.

        //- New Stock Info
        .glass-card
          h6.text-info.mb-3  Just Added to Inventory
          each product in newStock
            .d-flex.align-items-center.mb-2
              .p-2.bg-info.rounded.me-2
              div
                p.mb-0.small.fw-bold #{product.itemName}
                small.text-muted UGX #{product.retailPrice.toLocaleString()}