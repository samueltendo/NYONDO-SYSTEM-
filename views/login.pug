doctype html
html
  head
    title NyondoStock | #{title}
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css")
    link(rel="stylesheet" href="/css/style.css")
  body.landing-page
    .container.d-flex.justify-content-center.align-items-center.vh-100
      .glass-card.text-center(style="max-width: 450px; width: 100%;")
        h2.text-cyan.fw-bold NYONDO STOCK
        p.text-white-50.mb-4 Staff Authentication Terminal
        
        if error
          .alert.alert-danger.py-2.small #{error}

        form(action="/auth/login" method="POST")
          .form-group.text-start.mb-3
            label.text-white-50.small Email Address
            input.form-control.bg-dark.text-white.border-secondary(type="email" name="email" required)
          .form-group.text-start.mb-4
            label.text-white-50.small Password
            input.form-control.bg-dark.text-white.border-secondary(type="password" name="password" required)
          button.btn-cyan.w-100(type="submit") ACCESS SYSTEM
        
        .mt-4
          a.text-info.small(href="/auth/register") Need a staff account? Register

        