extends layout

block content
  .container-fluid
    .row.mb-4.align-items-center
      .col-md-8
        h2.text-.fw-bold Deposit Scheme Management
        p.text- Record customer savings for hardware materials.
      .col-md-4.text-end
        a.btn-cyan(href="/dashboard" style="text-decoration: none; font-size: 0.8rem;") ← BACK TO DASHBOARD

    if error
      .error-msg.mb-4 #{error}

    .row.g-4
      //- Deposit Entry Form
      .col-lg-4
        .glass-card
          h5.text-.mb-4 Record New Transaction
          form(action="/deposits/add" method="post")
            .mb-2
              label.text- Customer Name
              input.form-control(name="customerName" required)
            .mb-2
              label.text-.small Phone Number
              input.form-control(name="phone" pattern="[0-9]{10}" placeholder="07XXXXXXXX" title="Enter a valid 10-digit Ugandan phone number(e.g., 0701234567)" required)
            .mb-2
              label.text-  NIN
              input.form-control(name="nin" minlength="16" maxlength="16" title="Enter a valid 16-character NIN (e.g., CM12345678901234)" oninput="this.value = this.value.toUpperCase()" required)
            .mb-3
              label.text-  Amount to Deposit (UGX)
              input.form-control.blue-input(type="number" name="amount" min="100000" required)
            
            button.btn-cyan.w-100(type="submit") SUBMIT DEPOSIT

      //- Ledger Table
      .col-lg-8
        .glass-card
          h5.text-.mb-4 Recent Deposits Ledger
          .table-responsive
            table.table.table-white.table-sm.mb-0
              thead
                tr
                  th Customer
                  th NIN 
                  th Contact 
                  th.text-end Balance (UGX)
                  th.text-center Date
              tbody
                if accounts.length > 0
                  each acc in accounts
                    tr
                      td: .fw-bold.text-= acc.customerName
                      td: small.text-(style="font-size: 0.7rem;") #{acc.nin}
                      td
                        small.d-block.text-= acc.phone
                      td.text-end.fw-bold(style="color: var(--success-green)")= acc.amount.toLocaleString()
                      td.text-center.small.text-= acc.date.toLocaleDateString()
                else
                  tr
                    td.text-center.py-4(colspan="4") No deposit records found in database.