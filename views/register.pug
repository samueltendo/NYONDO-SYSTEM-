extends layout

block content
  .container.py-5
    .row.justify-content-center
      .col-md-6
        .glass-card
          h4.text-cyan.text-center Staff Registration
          hr.border-secondary
          if error
            .alert.alert-danger #{error}
          form(action="/auth/register" method="POST")
            .mb-3
              label.text-white-50 Full Name
              input.form-control(type="text" name="fullname" required)
            .row
              .col-md-6.mb-3
                label.text-white-50 Phone
                input.form-control(type="tel" name="phone" required)
              .col-md-6.mb-3
                label.text-white-50 NIN
                input.form-control(type="text" name="nin" required)
            .mb-3
              label.text-white-50 Role
              select.form-select(name="role" required)
                option(value="attendant") Sales Attendant
                option(value="manager") Store Manager
                option(value="admin") Accounts/Admin
            .mb-3
              label.text-white-50 Email
              input.form-control(type="email" name="email" required)
            .mb-4
              label.text-white-50 Password
              input.form-control(type="password" name="password" required)
            
            button.btn-cyan.w-100(type="submit") Create Staff Account