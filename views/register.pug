extends layout

block content
  .container.py-5
    .row.justify-content-center
      .col-md-6
        .glass-card
          h4.text-.text-center Staff Registration
          hr.border-secondary
          if error
            .alert.alert-danger #{error}
          form(action="/auth/login" method="POST")
            .mb-3
              label.text- Full Name
              input.form-control(type="text" name="fullname" required)
            .row
              .col-md-6.mb-3
                label.text- Phone
                input.form-control(type="tel" name="phone"  title="Enter a valid 10-digit Ugandan phone number(e.g., 0701234567)" required)
              .col-md-6.mb-3
                label.text- NIN
                input.form-control(type="text" name="nin" oninput="this.value = this.value.toUpperCase();" required)
            .mb-3
              label.text- Role
              select.form-select(name="role" required)
                option(value="attendant") Sales Attendant
                option(value="manager") Store Manager
                option(value="admin") Accounts/Admin
            .mb-3
              label.text- Email
              input.form-control(type="email" name="email" required)
            .mb-4
              label.text- Password
              input.form-control(type="password" name="password" required)
            
            button.btn-cyan.w-100(type="submit") Create Staff Account