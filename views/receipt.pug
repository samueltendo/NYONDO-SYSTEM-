doctype html
html
  head
    title Nyondo Receipt - #{receiptNo}
    link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css')
    style.
      @media print {
        .no-print { display: none; }
        body { background: white; }
        .receipt-card { border: none !important; box-shadow: none !important; }
      }
      .receipt-card { max-width: 600px; margin: 20px auto; border: 1px solid #ddd; padding: 30px; background: #fff; }
      .text-cyan { color: #008b8b; }
      .border-top-thick { border-top: 2px solid #333; }

  body.bg-light
    .container
      .no-print.text-center.mt-3
        button.btn.btn-primary(onclick="window.print()")  Print Receipt
        //- UPDATED: Redirects to Attendant Dashboard instead of sales list
        a.btn.btn-outline-secondary.ms-2(href="/sales_dashboard") Back to Dashboard

      .receipt-card.shadow-sm
        .text-center.mb-4
          h2.text-cyan.fw-bold NYONDO GENERAL HARDWARE LTD
          p.small.mb-1 Entebbe, Uganda | Tel: +256 700 435 479 | +256 772 435 479  
          p.small Email: info@nyondo.com | www.nyondo.com
          h5.mt-3.text-uppercase(style="letter-spacing: 2px;") Official Receipt

        .row.mb-4
          .col-6
            p.mb-0.small.text-muted Billed To:
            p.fw-bold.mb-0 #{sale.customerName || '#{sale.customerCompany || "Walk-in Customer"}'}
            p.small #{sale.customerContact || 'N/A'}
          .col-6.text-end
            p.mb-0.small.text-muted Receipt Details:
            p.mb-0.small #[strong No:] #{receiptNo}
            p.mb-0.small #[strong Date:] #{new Date(sale.saleDate).toLocaleString()}
            p.mb-0.small #[strong Branch:] Entebbe

        table.table.table-sm
          thead.table-light
            tr
              th Item
              th.text-center Qty
              th.text-end Unit Price
              th.text-end Subtotal
          tbody
            tr
              td #{sale.itemName}
              td.text-center #{sale.quantitySold}
              td.text-end #{sale.unitPrice.toLocaleString()}
              td.text-end #{(sale.quantitySold * sale.unitPrice).toLocaleString()}
            
            if sale.transportFee > 0
              tr
                td(colspan="3").text-end Transport Fee (#{sale.distanceKm} KM)
                td.text-end #{sale.transportFee.toLocaleString()}   
          tfoot
            tr.border-top-thick
              th(colspan="3").text-end.fs-5 TOTAL AMOUNT (UGX)
              th.text-end.fs-5.text-cyan #{sale.totalAmount.toLocaleString()}
        .mt-5.text-center
          p.small.text-muted Thank you for choosing Nyondo Hardware!
          p.small.text-muted Goods once sold are not returnable.
          .mt-3(style="border-top: 1px dashed #ccc; padding-top: 10px;")
            p.small Authorized Signature: ........................
            //- Added safety check for the issued by name
            small.text-muted (Issued by: #{user ? user.fullname : 'Staff On Duty'})

    //- UPDATED: Added Auto-Print Script
    script.
      window.onload = function() {
        // Automatically opens the print dialog when the page loads
        window.print();
        
        // Optional: Automatically redirect back to dashboard after printing/cancelling
        // window.onafterprint = function() {
        //   window.location.href = '/attendant-dashboard';
        // };
      }