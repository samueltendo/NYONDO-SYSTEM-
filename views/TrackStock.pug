extends layout

block content
  .container-fluid.py-4
    h2.text.fw-bold.mb-4  Manager - Stock Tracking
    p.text.mb-4 Monitor inventory levels, identify best sellers, and track items nearing expiry or low stock.

    .row.g-4
      //-  Best Sellers
      .col-md-6.col-xl-3
        .glass-card.p-3.border-success
          h6.text-success.small.fw-bold BEST SELLERS (30D)
          each item in bestSellers
            .d-flex.justify-content-between.mb-1
              span.small #{item._id}
              span.badge.bg-success #{item.totalSold} sold

      //-  Recently Added
      .col-md-6.col-xl-3
        .glass-card.p-3.border-primary
          h6.text-primary.small.fw-bold  RECENTLY ADDED (7D)
          each item in recentlyAdded
            .d-flex.justify-content-between.mb-1
              span.small #{item.itemName}
              span.small.text-primary.fw-bold Added #{item.dateAdded.toLocaleDateString()}
            p.text-muted.small No new stock added in the last 7 days.
            

      //-  Low Stock
      .col-md-6.col-xl-3
        .glass-card.p-3.border-danger
          h6.text-danger.small.fw-bold  REORDER REQUIRED
          each item in lowStock
            .d-flex.justify-content-between.mb-1
              span.small #{item.itemName}
              span.text-danger.fw-bold #{item.quantity} left

      //-  Expiring Soon
      .col-md-6.col-xl-3
        .glass-card.p-3.border-warning
          h6.text-warning.small.fw-bold  EXPIRING (<30D)
          each item in expiringSoon
            .d-flex.justify-content-between.mb-1
              span.small #{item.itemName}
              span.extra-small.text-warning #{item.expiryDate.toLocaleDateString()}

      //-  Overstayed / Dead Stock
      .col-md-6.col-xl-3
        .glass-card.p-3.border-info
          h6.text-info.small.fw-bold  OVERSTAYED  STOCK (>90D)
          each item in overstayed
            .d-flex.justify-content-between.mb-1
              span.small #{item.itemName}
              span.extra-small.text-info Since #{item.dateAdded.toLocaleDateString()}

    //- Main Detailed List
    .mt-5
      .glass-card.p-0
        table.table.table-white.table-hover.mb-0
          thead
            tr.small.text-white-50
              th ITEM
              th CATEGORY
              th STOCK
              th RETAIL PRICE
              th STATUS
          tbody
            each item in recentlyAdded
              tr
                td #{item.itemName}
                td #{item.category}
                td #{item.quantity}
                td UGX #{item.retailPrice.toLocaleString()}
                td: span.badge.bg-primary RECENTLY ADDED
            each item in overstayed
              tr
                td #{item.itemName}
                td #{item.category}
                td #{item.quantity}
                td UGX #{item.retailPrice.toLocaleString()}
                td: span.badge.bg-info OVERSTAYED
            each item in expiringSoon
              tr
                td #{item.itemName}
                td #{item.category}
                td #{item.quantity}
                td UGX #{item.retailPrice.toLocaleString()}
                td: span.badge.bg-warning EXPIRING
            each item in lowStock
              tr
                td #{item.itemName}
                td #{item.category}
                td #{item.quantity}
                td UGX #{item.retailPrice.toLocaleString()}
                td: span.badge.bg-danger LOW STOCK
            each item in bestSellers
              tr
                td #{item._id}
                td #{item.category}
                td #{item.quantity}
                td #{item.totalSold} sold
                td: span.badge.bg-success BEST SELLS 