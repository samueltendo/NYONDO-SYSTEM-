extends layout

block content
  .container-fluid.py-4
    h1.text.mb-4 Multi-Item Sales Point
    
    .row
      //-  Product Selection & Cart
      .col-lg-5
        .glass-card.mb-4
          h2.text.h4.mb-3  Customer Details
          .row
            .col-md-6.mb-3
              label.small.text- Customer Name
              input#customerName.form-control(type="text" name="customerName" required)
            .col-md-6.mb-3
              label.small.text- Phone Number
              input#customerContact.form-control(type="text" name="customerContact" pattern="^(07|03)[0-9]{8}$" oninput="this.value=this.value.replace(/[^0-9]/g,'')" title="Enter a valid Ugandan phone number (e.g., 0701234567)" required)
          .mb-3
            label.small.text- Delivery Distance (KM)
            input#distanceKm.form-control(type="number" name="distanceKm" value="0")

        .glass-card
          h2.text.h4.mb-3  Add Items
          .mb-3
            label.small.text- Select Product
            select#productSelect.form-select
              option(value="" disabled selected) -- Choose Product --
              each item in inventory
                option(value=item._id data-name=item.itemName data-price=item.retailPrice data-stock=item.quantity) #{item.itemName} (Stock: #{item.quantity})
          
          .row.align-items-end
            .col-8
              label.small.text- Quantity
              input#itemQty.form-control(type="number" min="1")
            .col-4
              button.btn-cyan.btn-outline-info.w-100(onclick="addToCart()") Add
          
          hr.border-secondary.my-4

          //- THE CART TABLE
          h5.text.small.mb-3 YOUR CART
          table.table.table-sm.table-dark.small#cartTable
            thead
              tr
                th Item
                th Quantity
                th Total
                th
            tbody
              tr
                td.text-center(colspan="4") Cart is empty. Add items to see them here.
          
          .d-flex.justify-content-between.mt-3.fw-bold
            span Total:
          .d-flex.justify-content-between.mt-1.fw-bold.fs-5
            span#grandTotal UGX 0

          //- HIDDEN FORM TO SUBMIT DATA
          form#finalSaleForm(action="/sales/product" method="POST")
            input#cartData(type="hidden" name="cartData")
            input#finalCustomer(type="hidden" name="customerName")
            input#finalContact(type="hidden" name="customerContact")
            input#finalDistance(type="hidden" name="distanceKm")
          .d-flex.justify-content-lg-end.gap-2.mt-4
            button.btn.btn-info.w-100.mt-1(type="button" onclick="submitSale()") 
              i.bi.bi-printer 
              |  Process Sale & Print
            a.btn-cyan.btn-secondary.w-40.mt-1(href="/sales") Cancel 

      //- Right Column: Sales History (Remains same)
      .col-lg-7
        .glass-card.p-0.overflow-hidden
          h2.text-black-50.h4.p-3.mb-0 3. Sales History
          table.table.table-white.table-hover.mb-0
            thead
              tr
                th.ps-4 Customer
                th.contact Contact
                th.transportation Transport
                th Total
                th.text-end.pe-4 Action
            tbody
              each sale in sales
                tr
                  td.ps-4 
                    .fw-bold #{sale.customerName}
                  td.ps-4
                    .fw-dark.text- #{sale.customerContact}
                  td.ps-4
                      .fw-dark.text- #{sale.distanceKm} km
                  td UGX #{(sale.totalAmount || 0).toLocaleString()}
                  td.text-end.pe-4
                    form(action=`/sales/receipt/${sale._id}` method="GET")
                      button.btn.btn-outline-info.btn-sm(type="submit")
                        i.bi.bi-receipt 
                        | Receipt

      script.
            let cart = [];

            function addToCart() {
              const select = document.getElementById('productSelect');
              const qtyInput = document.getElementById('itemQty');
              const qty = parseInt(qtyInput.value);
              
              // Fixed: Wrapped logic in a block to prevent Pug parsing errors
              if (!select.value || isNaN(qty) || qty <= 0) {
                  alert("Select product and quantity");
                  return;
              }

              const option = select.options[select.selectedIndex];
              const stock = parseInt(option.dataset.stock);

              if (qty > stock) {
                  alert("Not enough stock!");
                  return;
              }

              const item = {
                productId: select.value,
                itemName: option.dataset.name,
                price: parseInt(option.dataset.price),
                quantitySold: qty,
                total: parseInt(option.dataset.price) * qty
              };

              cart.push(item);
              renderCart();
              qtyInput.value = "";
            }

            function renderCart() {
              const tbody = document.querySelector('#cartTable tbody');
              tbody.innerHTML = '';
              let total = 0;

              if (cart.length === 0) {
                tbody.innerHTML = '<tr><td colspan="4" class="text-center">Cart is empty.</td></tr>';
              } else {
                cart.forEach((item, index) => {
                  total += item.total;
                  tbody.innerHTML += `
                    <tr>
                      <td>${item.itemName}</td>
                      <td>${item.quantitySold}</td>
                      <td>${item.total.toLocaleString()}</td>
                      <td class="text-end"><i class="bi bi-x-circle text-danger" onclick="removeItem(${index})" style="cursor:pointer"></i></td>
                    </tr>
                  `;
                });
              }
              document.getElementById('grandTotal').innerText = `UGX ${total.toLocaleString()}`;
            }

            function removeItem(index) {
              cart.splice(index, 1);
              renderCart();
            }

            function submitSale() {
              const phoneInput = document.getElementById('customerContact');
              const phoneValue = phoneInput.value.trim();
              const customerName = document.getElementById('customerName').value.trim();

              if (cart.length === 0) {
                  alert("Please add at least one item to the cart.");
                  return;
              }

              if (!customerName) {
                  alert("Please enter customer name.");
                  return;
              }

              // Validates Ugandan number: starts with 07 or 03 and is 10 digits total
              const ugPhoneRegex = /^(07|03)\d{8}$/;
              if (!ugPhoneRegex.test(phoneValue)) {
                  alert("Invalid number! Please enter a valid Ugandan phone number (e.g., 0701234567).");
                  phoneInput.focus();
                  return; 
              }
              
              document.getElementById('cartData').value = JSON.stringify(cart);
              document.getElementById('finalCustomer').value = customerName;
              document.getElementById('finalContact').value = phoneValue;
              document.getElementById('finalDistance').value = document.getElementById('distanceKm').value;
              
              document.getElementById('finalSaleForm').submit();
            }