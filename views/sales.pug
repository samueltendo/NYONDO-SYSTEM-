extends layout

block content
    .container-fluid.py-4
        h1.text-cyan.mb-4 Sales Dashboard
        
        .row
            //- Left Column: Record Sale Form (4 Columns)
            .col-lg-4.mb-4
                .glass-card
                    h2.text-cyan.h4.mb-4 New Sale
                    if error
                        .alert.alert-danger.py-2.small #{error}
                    
                    form(action="/sales/product" method="POST")
                        .mb-3
                            label.form-label.text-white-50 Customer Name
                            input.form-control(type="text" name="customerName" required placeholder="Full Name")
                        
                        .mb-3
                            label.form-label.text-white-50 Phone Number
                            input.form-control(type="text" name="customerContact" required placeholder="07...")

                        .mb-3
                            label.form-label.text-white-50 Select Item
                            select.form-select(name="productId" required)
                                option(value="" disabled selected) -- Choose Product --
                                each item in inventory
                                    option(value=item._id) #{item.itemName} (Stock: #{item.quantity} | Price: #{item.retailPrice.toLocaleString()})
                        
                        .row
                            .col-6.mb-3
                                label.form-label.text-white-50 Quantity
                                input.form-control(type="number" name="quantitySold" min="1" required)
                            .col-6.mb-3
                                label.form-label.text-white-50 Distance (KM)
                                input.form-control(type="number" name="distanceKm" step="0.1" value="0")
                        
                            //- Action Buttons
                        //- Action Buttons
                        .d-grid.gap-2.mt-4
                            button.btn.btn-cyan.w-100(type="submit") 
                                i.bi.bi-printer.me-2
                                | Process & Print Receipt
                            a.btn.btn-outline-secondary.btn-sm.w-100(href="/sales") Cancel & Return
                                            
                        

            //- Right Column: Today's Sales History (8 Columns)
            .col-lg-8
                .glass-card
                    h2.text-cyan.h4.mb-4 Today's Sales Log
                    .table-responsive
                        table.table.table-dark.table-hover
                            thead
                                tr
                                    th Customer 
                                    th Contact
                                    th Attendant 
                                    th Date
                                    th Item
                                    th Qty
                                    th Transport
                                    th Total (UGX)
                            tbody
                                if sales && sales.length > 0
                                    each sale in sales
                                        tr
                                            td #{sale.customerName}
                                            td #{sale.customerContact}
                                            td #{sale.attendantName}
                                            td #{new Date(sale.saleDate).toLocaleDateString()}
                                            td #{sale.itemName}
                                            td #{sale.quantitySold}
                                            td #{sale.transportFee ? sale.transportFee.toLocaleString() : 0}
                                            td.text-cyan.fw-bold #{sale.totalAmount.toLocaleString()}
                                else
                                    tr
                                        td(colspan="5").text-center.py-5 No sales recorded today.


























