extends layout

block content
  .container-fluid
    h1.text- Supplier Credit Management
    p.text-black-50 Track debts and upcoming payments to hardware suppliers.

    .row.g-4
      //- Form: Record New Credit
      .col-lg-4
        .glass-card
          h4.text- New Credit Record
          form(action="/credit/add" method="post")
            .form-group.mb-3
              label Supplier Name
              input.form-control(type="text" name="supplierName" title="Enter the supplier's name" required)
            .form-group.mb-3
              label Item/Description
              input.form-control(type="text" name="item" title="Enter the item or description" required)
            .form-group.mb-3
              label Quantity
              input.form-control(type="number" name="quantity" title="Enter the quantity" required)
            .form-group.mb-3
              label.small.text- Unit
              select.form-select.bg-dark.text-white(name="unit" required min="1" placeholder="e.g. Piece")
                  option(value="") -- Select Unit --
                  option(value="Kg") Kilogram
                  option(value="Bag") Bag
                  option(value="Piece") Piece
                  option(value="Litre") Litre
                  option(value="Pair") Pair
                  option(value="Roll") Roll
                  option(value="Box") Box
                  option(value="Meter") Meter
                  option(value="Foot") Foot
                  option(value="Ton") Ton
                  option(value="Packet") Packet
                  option(value="Sheet") Sheet
            .form-group.mb-3
              label Amount Owed (UGX)
              input.form-control.blue-input(type="number" name="amountOwed" title="Enter the amount owed" required)
            .form-group.mb-3
              label Due Date
              input.form-control(type="date" name="dueDate" title="Select the due date" required)
            button.btn-cyan.w-100(type="submit") Save Credit Record

      //- Table: Credit List
      .col-lg-8
        .glass-card
          h4.text- Active Credits
          table.table.table-white.table-sm.mb-0
            thead
              tr
                th SupplierName 
                th Item
                th Amount (UGX)
                th Due Date
                th Status
                th Action
            tbody
              each c in credits
                tr
                  td #{c.supplierName}
                  td #{c.item}
                  td #{c.amountOwed.toLocaleString()}
                  td #{c.dueDate.toLocaleDateString()}
                  td
                    span(style=`color: ${c.status === 'Paid' ? 'var(--success-green)' : 'orange'}`) #{c.status}
                  td
                    if c.status === 'Pending'
                      form(action=`/credit/pay/${c._id}` method="post" style="display:inline;")
                        button.btn-cyan(style="padding: 5px 10px; font-size: 0.7rem;") MARK PAID
                    else
                      span.text- Completed

