
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Nyondo General Hardware | #{title}
    link(rel="stylesheet" href="/css/style.css")
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")    
  body
    nav.navbar.navbar-expand-lg.navbar-dark.sticky-top.shadow-sm(style="background: #010816;")
      .container
        a.navbar-brand.fw-bold(href="/" style="color: #00f2ff;") 🛠️ NYONDO HARDWARE
        
        button.navbar-toggler(type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav")
          span.navbar-toggler-icon
        
        #navbarNav.collapse.navbar-collapse
          ul.navbar-nav.ms-auto.align-items-center
            if user && user.role
              //- 1. STORE MANAGER: Register stock, set prices, track levels
              //- if user.role.toLowerCase() === 'manager'
              if user.role === 'Store Manager' || user.role === 'manager'
                li.nav-item: a.nav-link(href="/manager_dashboard") Dashboard
                li.nav-item: a.nav-link(href="/products") Register Stock
                li.nav-item: a.nav-link(href="/products/restock") Restock 
                li.nav-item: a.nav-link(href="/manager_dashboard/TrackStock") Track Stock Levels

              //- 2. SALES ATTENDANT: Record sales, issue receipts, check stock
              if user.role === 'Sales Attendant' || user.role === 'attendant'
                li.nav-item: a.nav-link(href="/sales_dashboard") Dashboard
                li.nav-item: a.nav-link(href="/sales") Record Sales
                li.nav-item: a.nav-link(href="/sales/stock-log") Check Stock

              //- 3. ADMIN / ACCOUNTS: Supplier credit, deposits, reports
              if user.role === 'Admin' || user.role === 'admin'
                li.nav-item: a.nav-link(href="/dashboard") Dashboard
                li.nav-item: a.nav-link(href="/credit") Supplier Credit
                li.nav-item: a.nav-link(href="/deposits") Manage Deposits
                li.nav-item: a.nav-link(href="/reports") Financial Reports
                li.nav-item: a.nav-link(href="/users") Manage Users

              li.nav-item.ms-lg-3
                a.btn.btn-sm.px-3(href="/auth/logout" style="background: #00f2ff; color: #000; font-weight: bold; text-decoration: none; border-radius: 4px;") Logout
            else
              li.nav-item: a.nav-link(href="/auth/login") Staff Login

    main.container.my-5
      block content

    footer.text-center.mt-5.py-4(style="border-top: 1px solid rgba(255,255,255,0.1);")
      .container
        p.text-.mb-1 © 2026 NYONDO General Hardware LTD.
        p.mb-1 Digitized Management System
        //- small.text-muted(style="font-size: 0.75rem;") 
        //-   | Session User: #{ (user && user.fullname) ? user.fullname } | 
        //-   | Role: #{ (user && user.role) ? user.role.toUpperCase() }

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")
     
     